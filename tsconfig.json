{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "outDir": "out", "rootDir": "src", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src"]
}
