{
  "name": "open-provider",
  "displayName": "Open Provider",
  "description": "Use any OpenAI-compatible API as a native model provider for VS Code Copilot Chat and Agent.",
  "version": "0.2.7",
  "icon": "assets/icon.png",
  "keywords": [
    "openai",
    "openai-compatible",
    "provider",
    "deepseek",
    "copilot",
    "agent",
    "language-model",
    "llm"
  ],
  "publisher": "ahang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatProvider",
    "languageModelThinkingPart",
    "languageModelSystem"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "open-provider",
        "displayName": "Open Provider",
        "managementCommand": "openProvider.manage"
      }
    ],
    "commands": [
      {
        "command": "openProvider.configure",
        "title": "Open Provider: Configure"
      },
      {
        "command": "openProvider.manage",
        "title": "Open Provider: Manage Models"
      },
      {
        "command": "openProvider.refresh",
        "title": "Open Provider: Refresh Models"
      }
    ],
    "configuration": {
      "title": "Open Provider",
      "properties": {
        "openProvider.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "OpenAI-compatible API base URL, including any path prefix. A bare host defaults to /v1. Store the API key securely with Open Provider: Configure."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.137.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0"
  },
  "preview": true
}
